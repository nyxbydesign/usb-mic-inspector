<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-feature android:name="android.hardware.usb.host" android:required="true" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application android:label="USB Mic Inspector" android:icon="@drawable/ic_usb_mic" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- USB is an alternative connectedDevice prerequisite: UsbManager.requestPermission()
             is called by the activity; the service rechecks hasPermission() before promotion.
             Lint 8.7.3 checks only the manifest permission alternatives.
             https://developer.android.com/about/versions/14/changes/fgs-types-required#connected-device -->
        <service android:name=".CaptureClaimService" android:foregroundServiceType="connectedDevice" android:exported="false" android:stopWithTask="true" tools:ignore="ForegroundServicePermission" />
    </application>
</manifest>
